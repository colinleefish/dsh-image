# Exact official @deepseek-ai/dsh version packaged by the image.
DSH_VERSION=0.2.2-rc.1

# Immutable container revision (separate from DSH_VERSION).
DSH_IMAGE_VERSION=0.2.2-rc.1-r1

DSH_IMAGE_REPOSITORY=ghcr.io/colinleefish/dsh-image
NODE_IMAGE=docker.io/library/node:24-trixie
PNPM_VERSION=10.15.1
UV_VERSION=0.9.7

# Host loopback publish port.
DSH_PORT=3080

# Absolute or relative host path mounted as /workspace.
DSH_WORKSPACE=./workspace

# Optional reverse-proxy trust (Tailscale / nginx).
# DSH_WEB_EXTRA_ARGS=--public-url http://100.84.0.2:3080 --trusted-host 100.84.0.2:3080
