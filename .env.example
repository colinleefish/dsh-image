# --- docker compose (runtime only); copy to .env ---

# Image tag: same as @deepseek-ai/dsh on npm — see IMAGES.md.
DSH_IMAGE_VERSION=0.2.3-alpha.2

# Pull from ACR (China) or Docker Hub.
DSH_IMAGE_REPOSITORY=registry.cn-beijing.aliyuncs.com/colinleefish/dsh-image
# DSH_IMAGE_REPOSITORY=docker.io/colinleefish/dsh-image

DSH_PORT=3080

# Optional reverse-proxy trust (nginx / Tailscale, etc.).
# DSH_WEB_EXTRA_ARGS=--public-url http://YOUR_HOST:3080 --trusted-host YOUR_HOST:3080